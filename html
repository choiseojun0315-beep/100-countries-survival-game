<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>100개국 달리기 서바이벌</title>
    <style>
        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 15px;
        }

        .container {
            background-color: #1e1e1e;
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            text-align: center;
            width: 100%;
            max-width: 450px;
        }

        h1 {
            color: #ffca28;
            font-size: 1.4rem;
            margin-top: 0;
            margin-bottom: 10px;
        }

        .status-box {
            font-size: 1.1rem;
            margin-bottom: 15px;
            color: #4caf50;
            font-weight: bold;
            min-height: 1.5em;
        }

        .track-container {
            background-color: #2a2a2a;
            border: 2px solid #444;
            border-radius: 10px;
            padding: 10px;
            height: 250px;
            overflow-y: auto;
            margin-bottom: 15px;
            text-align: left;
        }

        .runner-row {
            display: flex;
            align-items: center;
            margin-bottom: 8px;
            font-size: 0.85rem;
        }

        .runner-name {
            width: 70px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .track-line {
            flex-grow: 1;
            background-color: #333;
            height: 12px;
            border-radius: 6px;
            margin: 0 8px;
            position: relative;
            overflow: hidden;
        }

        .progress-bar {
            background-color: #ff9800;
            height: 100%;
            width: 0%;
            border-radius: 6px;
            transition: width 0.1s linear;
        }

        button {
            background-color: #ff9800;
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 30px;
            cursor: pointer;
            width: 100%;
            box-shadow: 0 4px 10px rgba(255, 152, 0, 0.3);
            transition: background 0.2s, transform 0.1s;
        }

        button:active {
            transform: scale(0.96);
            background-color: #f57c00;
        }

        button:disabled {
            background-color: #555555;
            box-shadow: none;
            cursor: not-allowed;
        }

        .rank-table-container {
            display: none;
            max-height: 300px;
            overflow-y: auto;
            margin-top: 15px;
            border: 1px solid #444;
            border-radius: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }

        th, td {
            padding: 8px 12px;
            border-bottom: 1px solid #333;
            text-align: center;
        }

        th {
            background-color: #333;
            color: #ffca28;
            position: sticky;
            top: 0;
        }

        tr:nth-child(even) {
            background-color: #252525;
        }

        .top3 {
            color: #ffca28;
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="container">
    <h1 id="title">🏃‍♂️ 100개국 달리기 서바이벌</h1>
    <div class="status-box" id="status">시작 버튼을 눌러 게임을 개시하세요!</div>
    
    <div class="track-container" id="track">
        <!-- 달리기 트랙이 여기에 동적으로 생성됩니다 -->
    </div>

    <div class="rank-table-container" id="rank-container">
        <table>
            <thead>
                <tr>
                    <th>순위</th>
                    <th>국가</th>
                </tr>
            </thead>
            <tbody id="rank-tbody"></tbody>
        </table>
    </div>

    <button id="action-btn" onclick="handleButtonClick()">게임 시작</button>
</div>

<script>
    const ALL_COUNTRIES = [
        "한국", "일본", "중국", "미국", "캐나다", "멕시코", "브라질", "아르헨티나", "칠레", "콜롬비아",
        "영국", "프랑스", "독일", "이탈리아", "스페인", "포르투갈", "네덜란드", "벨기에", "스위스", "오스트리아",
        "호주", "뉴질랜드", "인도", "베트남", "태국", "필리핀", "인도네시아", "말레이시아", "싱가포르", "대만",
        "이집트", "남아공", "모로코", "나이지리아", "케냐", "사우디", "UAE", "터키", "이스라엘", "그리스",
        "스웨덴", "노르웨이", "핀란드", "덴마크", "폴란드", "체코", "헝가리", "루마니아", "아일랜드", "러시아",
        "몽골", "카자흐스탄", "우즈베키스탄", "네팔", "스리랑카", "방글라데시", "파키스탄", "카타르", "요르단", "페루",
        "우루과이", "베네수엘라", "에콰도르", "볼리비아", "파라과이", "쿠바", "자메이카", "크로아티아", "세르비아", "슬로바키아",
        "불가리아", "우크라이나", "아이슬란드", "에스토니아", "라트비아", "리투아니아", "가나", "에티오피아", "탄자니아", "알제리",
        "튀니지", "카메룬", "세네갈", "피지", "파푸아뉴기니", "뉴칼레도니아", "마다가스카르", "앙골라", "모잠비크", "코스타리카",
        "파나마", "온두라스", "과테말라", "엘살바도르", "도미니카", "아이티", "라오스", "캄보디아", "미얀마", "브루나이"
    ];

    let currentRunners = [];
    let rankList = []; // 전체 등수를 기록할 배열
    let round = 1;
    let isRunning = false;

    const statusDiv = document.getElementById('status');
    const trackDiv = document.getElementById('track');
    const actionBtn = document.getElementById('action-btn');
    const rankContainer = document.getElementById('rank-container');
    const rankTbody = document.getElementById('rank-tbody');

    function handleButtonClick() {
        if (isRunning) return;

        if (round === 1 && currentRunners.length === 0) {
            // 게임 초기화
            currentRunners = [...ALL_COUNTRIES];
            rankList = [];
            rankContainer.style.display = 'none';
            trackDiv.style.display = 'block';
            runRound();
        } else if (currentRunners.length > 1) {
            runRound();
        } else {
            // 재경기
            round = 1;
            currentRunners = [];
            handleButtonClick();
        }
    }

    function renderTrack() {
        trackDiv.innerHTML = '';
        currentRunners.forEach((country, index) => {
            const row = document.createElement('div');
            row.className = 'runner-row';
            row.innerHTML = `
                <span class="runner-name">${country}</span>
                <div class="track-line">
                    <div class="progress-bar" id="bar-${index}"></div>
                </div>
            `;
            trackDiv.appendChild(row);
        });
    }

    function runRound() {
        isRunning = true;
        actionBtn.disabled = true;
        renderTrack();

        statusDiv.innerText = `라운드 ${round}: ${currentRunners.length}개국 경기 중!`;

        let progress = new Array(currentRunners.length).fill(0);
        let finished = [];

        let interval = setInterval(() => {
            let allFinished = true;

            for (let i = 0; i < currentRunners.length; i++) {
                if (progress[i] < 100) {
                    allFinished = false;
                    // 무작위 이동 속도 부여
                    progress[i] += Math.random() * 8 + 2;
                    if (progress[i] >= 100) {
                        progress[i] = 100;
                        if (!finished.includes(i)) {
                            finished.push(i);
                        }
                    }
                    const bar = document.getElementById(`bar-${i}`);
                    if (bar) bar.style.width = `${progress[i]}%`;
                }
            }

            if (allFinished) {
                clearInterval(interval);
                endRound(finished);
            }
        }, 100);
    }

    function endRound(finishedOrder) {
        // 이번 라운드 도착 순서대로 선수 정렬
        let roundResult = finishedOrder.map(idx => currentRunners[idx]);
        
        const survivorCount = Math.ceil(roundResult.length / 2);
        
        // 생존자와 탈락자 분리
        const survivors = roundResult.slice(0, survivorCount);
        const eliminated = roundResult.slice(survivorCount);

        // 탈락자들은 등수 리스트의 앞쪽에 추가 (나중에 탈락한 국가가 더 높은 등수)
        rankList = [...eliminated.reverse(), ...rankList];

        if (survivors.length === 1) {
            // 최종 우승자 발생
            rankList = [survivors[0], ...rankList]; // 우승자를 1위로
            showFinalResult();
        } else {
            currentRunners = survivors;
            statusDiv.innerText = `${eliminated.length}개국 탈락! ${currentRunners.length}개국 생존!`;
            actionBtn.innerText = "다음 라운드 진행";
            actionBtn.disabled = false;
            isRunning = false;
            round++;
        }
    }

    function showFinalResult() {
        isRunning = false;
        actionBtn.disabled = false;
        actionBtn.innerText = "처음부터 다시하기";
        
        statusDiv.innerText = `🏆 최종 우승국: ${rankList[0]}! 🏆`;
        
        // 트랙을 숨기고 전체 등수표 표시
        trackDiv.style.display = 'none';
        rankContainer.style.display = 'block';

        rankTbody.innerHTML = '';
        rankList.forEach((country, index) => {
            const tr = document.createElement('tr');
            const rank = index + 1;
            
            if (rank <= 3) {
                tr.className = 'top3';
            }
            
            tr.innerHTML = `
                <td>${rank}위</td>
                <td>${country}</td>
            `;
            rankTbody.appendChild(tr);
        });
    }

    // 최초 화면 구성
    currentRunners = [...ALL_COUNTRIES];
    renderTrack();
</script>

</body>
</html>
